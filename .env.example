# ---- 大模型（任何 OpenAI 兼容接口都可以）----
# DeepSeek:  https://api.deepseek.com          模型 deepseek-chat
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
# 智谱:      https://open.bigmodel.cn/api/paas/v4                模型 glm-4-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# ---- 向量化方式 ----
# hashing: 纯本地、零依赖（默认，够本项目用）
# openai:  调用 OpenAI 兼容的 embedding 接口，检索效果更好
EMBEDDING_MODE=hashing
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ---- 检索与 Agent ----
TOP_K=4
# 低于该余弦相似度视为“知识库里没有”，触发转人工
MIN_SCORE=0.15
MAX_STEPS=5

# 没有 key 时自动进入 mock 模式（规则模拟，仅用于跑通流程）
MOCK_LLM=auto
